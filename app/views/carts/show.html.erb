<% content_for :title, "Your Bag" %>

<div class="mx-auto max-w-5xl space-y-8">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Checkout</p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-zinc-950">Your Bag</h1>
    </div>
    <%= link_to "Continue shopping", products_path, class: "rounded-md px-3 py-2 text-sm font-semibold text-zinc-600 hover:bg-white hover:text-zinc-950" %>
  </div>

  <% if notice.present? %>
    <p class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></p>
  <% end %>

  <% if @cart.line_items.any? %>
    <section class="grid gap-6 lg:grid-cols-[1fr_360px]">
      <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
        <% @cart.line_items.each do |item| %>
          <div class="grid gap-4 border-b border-zinc-100 p-5 last:border-b-0 sm:grid-cols-[96px_1fr_auto] sm:items-center">
            <div class="h-24 w-24 overflow-hidden rounded-lg bg-stone-100">
              <%= image_tag item.product.image, class: "h-full w-full object-cover" if item.product.image.attached? %>
            </div>

            <div>
              <h2 class="text-lg font-bold text-zinc-950"><%= link_to item.product.title, item.product, class: "hover:text-emerald-800" %></h2>
              <p class="mt-1 text-sm text-zinc-600"><%= number_to_currency(item.product.price) %> each</p>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <%= form_with model: item, url: line_item_path(item), method: :patch, class: "flex items-center gap-2" do |form| %>
                  <%= form.label :quantity, class: "text-sm font-semibold text-zinc-700" %>
                  <%= form.number_field :quantity, value: item.quantity, min: 0, class: "h-10 w-20 rounded-md border border-zinc-300 px-3 text-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
                  <%= form.submit "Update", class: "h-10 cursor-pointer rounded-md bg-zinc-100 px-3 text-sm font-bold text-zinc-800 hover:bg-zinc-200" %>
                <% end %>
                <%= button_to "Remove", line_item_path(item), method: :delete, class: "h-10 rounded-md px-3 text-sm font-bold text-red-700 hover:bg-red-50" %>
              </div>
            </div>

            <p class="font-mono text-xl font-black text-zinc-950"><%= number_to_currency(item.total_price) %></p>
          </div>
        <% end %>
      </div>

      <aside class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm lg:sticky lg:top-24 lg:self-start">
        <h2 class="text-lg font-bold text-zinc-950">Order summary</h2>
        <div class="mt-5 space-y-3 border-b border-zinc-100 pb-5 text-sm">
          <div class="flex justify-between text-zinc-600">
            <span>Subtotal</span>
            <span class="font-mono font-bold text-zinc-950"><%= number_to_currency(@cart.total_price) %></span>
          </div>
          <div class="flex justify-between text-zinc-600">
            <span>Shipping</span>
            <span>Calculated later</span>
          </div>
        </div>
        <div class="mt-5 flex items-center justify-between">
          <span class="font-bold text-zinc-950">Estimated total</span>
          <span class="font-mono text-2xl font-black text-zinc-950"><%= number_to_currency(@cart.total_price) %></span>
        </div>
        <%= link_to "Proceed to checkout", new_order_path, class: "mt-6 block rounded-md bg-emerald-700 px-5 py-3 text-center text-sm font-bold text-white hover:bg-emerald-800" %>
        <%= button_to "Clear bag", cart_path, method: :delete, class: "mt-3 w-full rounded-md px-5 py-3 text-sm font-bold text-zinc-600 hover:bg-zinc-100", data: { turbo_confirm: "Clear every item from your bag?" } %>
      </aside>
    </section>
  <% else %>
    <section class="rounded-lg border border-dashed border-zinc-300 bg-white p-10 text-center">
      <h2 class="text-2xl font-black text-zinc-950">Your bag is empty</h2>
      <p class="mt-2 text-sm text-zinc-600">Add a few market essentials and they will show up here.</p>
      <%= link_to "Shop products", products_path, class: "mt-6 inline-flex rounded-md bg-zinc-950 px-5 py-3 text-sm font-bold text-white hover:bg-zinc-800" %>
    </section>
  <% end %>
</div>
