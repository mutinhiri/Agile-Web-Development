<% content_for :title, "Checkout" %>

<div class="mx-auto max-w-5xl space-y-8">
  <div>
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Almost there</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-zinc-950">Checkout</h1>
  </div>

  <section class="grid gap-6 lg:grid-cols-[1fr_360px]">
    <div class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm sm:p-8">
      <%= form_with(model: @order, class: "space-y-6") do |form| %>
        <% if @order.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
            <p class="font-bold">Please check the highlighted details.</p>
            <ul class="mt-2 list-disc pl-5">
              <% @order.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :name, class: "mb-2 block text-sm font-bold text-zinc-800" %>
            <%= form.text_field :name, placeholder: "Full name", class: "w-full rounded-md border border-zinc-300 px-3 py-2.5 shadow-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
          </div>

          <div>
            <%= form.label :email, class: "mb-2 block text-sm font-bold text-zinc-800" %>
            <%= form.email_field :email, placeholder: "you@example.com", class: "w-full rounded-md border border-zinc-300 px-3 py-2.5 shadow-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
          </div>
        </div>

        <div>
          <%= form.label :address, class: "mb-2 block text-sm font-bold text-zinc-800" %>
          <%= form.text_area :address, rows: 4, placeholder: "Shipping address", class: "w-full rounded-md border border-zinc-300 px-3 py-2.5 shadow-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>

        <div class="rounded-lg border border-zinc-200 bg-stone-50 p-5">
          <h2 class="font-bold text-zinc-950">Payment</h2>
          <p class="mt-1 text-sm leading-6 text-zinc-600">Payment collection can be connected once a provider is selected. For now, submitting this form records buyer intent and clears the bag.</p>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <%= link_to "Back to bag", cart_path, class: "rounded-md px-3 py-2 text-center text-sm font-semibold text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950" %>
          <%= form.submit "Place order", class: "cursor-pointer rounded-md bg-emerald-700 px-6 py-3 text-sm font-bold text-white hover:bg-emerald-800" %>
        </div>
      <% end %>
    </div>

    <aside class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm lg:sticky lg:top-24 lg:self-start">
      <h2 class="text-lg font-bold text-zinc-950">Summary</h2>
      <div class="mt-5 space-y-4">
        <% @cart.line_items.each do |item| %>
          <div class="flex justify-between gap-4 text-sm">
            <span class="text-zinc-600"><%= item.quantity %> x <%= item.product.title %></span>
            <span class="font-mono font-bold text-zinc-950"><%= number_to_currency(item.total_price) %></span>
          </div>
        <% end %>
      </div>
      <div class="mt-5 flex items-center justify-between border-t border-zinc-100 pt-5">
        <span class="font-bold text-zinc-950">Estimated total</span>
        <span class="font-mono text-2xl font-black text-zinc-950"><%= number_to_currency(@cart.total_price) %></span>
      </div>
    </aside>
  </section>
</div>
