<%= form_with(model: product, class: "space-y-6") do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
      <h2 class="font-bold"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul class="mt-2 list-disc pl-5">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "mb-2 block text-sm font-bold text-zinc-800" %>
    <%= form.text_field :title, class: ["block w-full rounded-md border px-3 py-2.5 shadow-sm focus:outline-none focus:ring-2", {"border-zinc-300 focus:border-emerald-700 focus:ring-emerald-700/20": product.errors[:title].none?, "border-red-400 focus:border-red-600 focus:ring-red-600/20": product.errors[:title].any?}] %>
  </div>

  <div>
    <%= form.label :description, class: "mb-2 block text-sm font-bold text-zinc-800" %>
    <%= form.textarea :description, rows: 8, class: ["block w-full rounded-md border px-3 py-2.5 shadow-sm focus:outline-none focus:ring-2", {"border-zinc-300 focus:border-emerald-700 focus:ring-emerald-700/20": product.errors[:description].none?, "border-red-400 focus:border-red-600 focus:ring-red-600/20": product.errors[:description].any?}] %>
  </div>

  <div>
    <%= form.label :image, class: "mb-2 block text-sm font-bold text-zinc-800" %>
    <%= form.file_field :image, accept: "image/*", class: ["block w-full rounded-md border px-3 py-2.5 text-sm shadow-sm file:mr-4 file:rounded-md file:border-0 file:bg-zinc-950 file:px-4 file:py-2 file:text-sm file:font-bold file:text-white hover:file:bg-zinc-800 focus:outline-none focus:ring-2", {"border-zinc-300 focus:border-emerald-700 focus:ring-emerald-700/20": product.errors[:image].none?, "border-red-400 focus:border-red-600 focus:ring-red-600/20": product.errors[:image].any?}] %>
  </div>

  <div>
    <%= form.label :price, class: "mb-2 block text-sm font-bold text-zinc-800" %>
    <%= form.text_field :price, class: ["block w-full rounded-md border px-3 py-2.5 shadow-sm focus:outline-none focus:ring-2", {"border-zinc-300 focus:border-emerald-700 focus:ring-emerald-700/20": product.errors[:price].none?, "border-red-400 focus:border-red-600 focus:ring-red-600/20": product.errors[:price].any?}] %>
  </div>

  <div>
    <%= form.submit class: "w-full cursor-pointer rounded-md bg-emerald-700 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-800 sm:w-auto" %>
  </div>
<% end %>
