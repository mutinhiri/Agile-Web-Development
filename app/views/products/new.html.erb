<% content_for :title, "New product" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-8">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Inventory</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-zinc-950">New product</h1>
  </div>

  <div class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", product: @product %>
  </div>

  <%= link_to "Back", products_path, class: "mt-5 inline-flex rounded-md px-3 py-2 text-sm font-semibold text-zinc-600 hover:bg-white hover:text-zinc-950" %>
</div>
