<% content_for :title, @product.title %>

<div class="space-y-8">
  <%= link_to "Back to catalog", products_path, class: "inline-flex rounded-md px-3 py-2 text-sm font-semibold text-zinc-600 hover:bg-white hover:text-zinc-950" %>

  <% if notice.present? %>
    <p class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" id="notice"><%= notice %></p>
  <% end %>

  <section class="grid overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm lg:grid-cols-[1fr_0.85fr]">
    <div class="aspect-square bg-stone-100 lg:aspect-auto">
      <% if @product.image.attached? %>
        <%= image_tag @product.image, class: "h-full w-full object-cover" %>
      <% else %>
        <div class="grid h-full min-h-[420px] place-items-center text-sm font-semibold text-zinc-400">No image</div>
      <% end %>
    </div>

    <div class="flex flex-col justify-between gap-8 p-6 sm:p-8 lg:p-10">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-emerald-700">Market pick</p>
        <h1 class="text-4xl font-black tracking-tight text-zinc-950 sm:text-5xl"><%= @product.title %></h1>
        <p class="mt-5 font-mono text-3xl font-black text-zinc-950"><%= number_to_currency(@product.price) %></p>
        <div class="prose prose-zinc mt-8 max-w-none text-zinc-700">
          <%= simple_format(@product.description) %>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
        <%= button_to line_items_path(product_id: @product.id), class: "rounded-md bg-zinc-950 px-5 py-3 text-sm font-bold text-white hover:bg-zinc-800" do %>
          Add to bag
        <% end %>
        <%= link_to "Keep shopping", products_path, class: "rounded-md border border-zinc-300 px-5 py-3 text-center text-sm font-bold text-zinc-800 hover:bg-zinc-100" %>
      </div>
    </div>
  </section>

  <section class="flex flex-wrap items-center gap-3 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm">
    <%= link_to "Edit this product", edit_product_path(@product), class: "rounded-md bg-zinc-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-zinc-800" %>
    <%= link_to "Back", products_path, class: "rounded-md px-4 py-2.5 text-sm font-bold text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950" %>
    <%= button_to "Destroy this product", @product, method: :delete, class: "rounded-md bg-red-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-800", data: { turbo_confirm: "Are you sure?" } %>
  </section>
</div>
