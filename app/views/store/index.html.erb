<% content_for :title, "Products" %>
<%= turbo_stream_from "products" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="space-y-10">
  <section class="overflow-hidden rounded-lg bg-zinc-950 text-white shadow-sm">
    <div class="grid min-h-[360px] lg:grid-cols-[1.05fr_0.95fr]">
      <div class="flex flex-col justify-between gap-10 p-8 sm:p-10 lg:p-12">
        <div class="max-w-2xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-emerald-300">Fresh market essentials</p>
          <h1 class="text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">Products</h1>
          <p class="mt-5 max-w-xl text-base leading-7 text-zinc-300 sm:text-lg">
            Everyday produce with clear pricing, quick filtering, and a checkout flow that gets out of the way.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="#catalog" class="rounded-md bg-white px-5 py-3 text-sm font-bold text-zinc-950 hover:bg-emerald-100">Shop catalog</a>
          <%= link_to "View bag", cart_path, class: "rounded-md border border-white/20 px-5 py-3 text-sm font-bold text-white hover:bg-white/10" %>
        </div>
      </div>

      <div class="relative min-h-[260px] bg-stone-200">
        <% hero_product = @products.detect { |product| product.image.attached? } %>
        <% if hero_product %>
          <%= image_tag hero_product.image, class: "h-full w-full object-cover" %>
        <% else %>
          <div class="grid h-full place-items-center bg-[radial-gradient(circle_at_30%_20%,#bbf7d0,transparent_28%),linear-gradient(135deg,#f5f5f4,#d9f99d)]">
            <div class="rounded-lg bg-white/80 px-5 py-4 text-zinc-900 shadow-sm backdrop-blur">
              <p class="text-sm font-semibold">Add product images to make the catalog shine.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <% if notice.present? || alert.present? %>
    <div class="rounded-lg border <%= alert.present? ? "border-red-200 bg-red-50 text-red-700" : "border-emerald-200 bg-emerald-50 text-emerald-800" %> px-4 py-3 text-sm font-medium">
      <%= alert.presence || notice %>
    </div>
  <% end %>

  <div class="grid gap-8 lg:grid-cols-[280px_1fr]" id="catalog">
    <aside>
      <div class="sticky top-24 rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="mb-5 flex items-center justify-between">
          <h2 class="text-lg font-bold text-zinc-950">Filters</h2>
          <span class="text-sm text-zinc-500"><%= pluralize(@products.size, "item") %></span>
        </div>

        <%= form_with url: products_path, method: :get, class: "space-y-5" do |f| %>
          <div>
            <%= f.label :query, "Search", class: "mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-zinc-500" %>
            <%= f.text_field :query, value: params[:query], placeholder: "Apples, bananas...", class: "w-full rounded-md border border-zinc-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
          </div>

          <div>
            <%= f.label :max_price, "Max price", class: "mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-zinc-500" %>
            <%= f.number_field :max_price, value: params[:max_price], placeholder: "Any", min: 0, step: "0.01", class: "w-full rounded-md border border-zinc-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
          </div>

          <div class="grid gap-2">
            <%= f.submit "Apply filters", class: "w-full cursor-pointer rounded-md bg-emerald-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-800" %>
            <%= link_to "Clear", products_path, class: "rounded-md px-4 py-2.5 text-center text-sm font-semibold text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950" %>
          </div>
        <% end %>
      </div>
    </aside>

    <section>
      <div class="mb-5 flex justify-end">
        <%= link_to "New product", new_product_path, class: "rounded-md bg-white px-4 py-2.5 text-sm font-bold text-zinc-800 shadow-sm ring-1 ring-zinc-200 hover:text-zinc-950" %>
      </div>

      <% if @products.any? %>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        <% @products.each do |product| %>
          <article class="group overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
              <%= link_to line_items_path(product_id: product.id), class: "block aspect-[4/3] overflow-hidden bg-stone-100" do %>
              <% if product.image.attached? %>
                <%= image_tag product.image, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
              <% else %>
                <div class="grid h-full place-items-center text-sm font-semibold text-zinc-400">No image</div>
               <% end %>
            <% end %>

            <div class="space-y-4 p-5">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-lg font-bold leading-tight text-zinc-950">
                  <%= link_to product.title, product, class: "hover:text-emerald-800" %>
                </h3>
                <p class="shrink-0 font-mono text-base font-black text-zinc-950"><%= number_to_currency(product.price) %></p>
              </div>

              <p class="line-clamp-2 min-h-10 text-sm leading-5 text-zinc-600">
                <%= strip_tags(product.description) %>
              </p>

              <%= button_to line_items_path(product_id: product.id), class: "flex w-full items-center justify-center gap-2 rounded-md bg-zinc-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-zinc-800" do %>
                <span aria-hidden="true">+</span>
                Add to bag
              <% end %>
            </div>
          </article>
        <% end %>
        </div>
      <% else %>
        <div class="rounded-lg border border-dashed border-zinc-300 bg-white p-10 text-center">
          <h2 class="text-xl font-bold text-zinc-950">No products found</h2>
          <p class="mt-2 text-sm text-zinc-600">Try clearing filters or searching for a different product.</p>
          <%= link_to "Clear filters", products_path, class: "mt-5 inline-flex rounded-md bg-zinc-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-zinc-800" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
